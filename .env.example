# Local dev (MySQL): DATABASE_URL="mysql://root:CHANGE_ME@localhost:3306/AdvanceLabDb"
# Production (Neon Postgres): DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DATABASE_URL="mysql://root:CHANGE_ME@localhost:3306/AdvanceLabDb"
PORT=5080

# Set to "production" when deployed - this flips the session cookie to
# SameSite=None; Secure (required because the frontend and backend live on
# different domains in production, e.g. Vercel + Render). Leave unset in dev.
NODE_ENV=

JWT_ISSUER=AdvanceLab.Api
JWT_AUDIENCE=AdvanceLab.Client
JWT_KEY=GENERATE_A_RANDOM_64_BYTE_BASE64_KEY
JWT_EXPIRY_HOURS=8

# Exact origin(s) of the deployed frontend, comma-separated, no trailing slash.
# e.g. https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

NOTIFICATIONS_ADMIN_EMAIL=info@advancelab.org
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
