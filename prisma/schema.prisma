generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Originally a 1:1 mirror of the MySQL/EF Core schema; converted to
// PostgreSQL for free-tier hosting (Neon). @db.LongText has no Postgres
// equivalent - String with no native-type attribute already maps to
// Postgres `text` by default, so those annotations are simply dropped.
// DateTime columns use @db.Timestamptz(6) (point-in-time, timezone-aware)
// instead of MySQL's @db.DateTime(6).

model AdminUser {
  Id                  Int       @id @default(autoincrement())
  Username            String    @unique(map: "IX_AdminUsers_Username") @db.VarChar(255)
  Email               String
  PasswordHash        String
  Role                String
  CreatedAt           DateTime  @db.Timestamptz(6)
  LastLoginAt         DateTime? @db.Timestamptz(6)
  ResetToken          String?
  ResetTokenExpiresAt DateTime? @db.Timestamptz(6)
  AvatarUrl           String?

  @@map("adminusers")
}

model Appointment {
  Id                 Int          @id @default(autoincrement())
  Name               String
  Address            String
  PhoneNo            String
  Email              String?
  ServiceItemId      Int?
  ServiceItem        ServiceItem? @relation(fields: [ServiceItemId], references: [Id], onDelete: SetNull)
  CollectionDateTime DateTime     @db.Timestamptz(6)
  Description        String?
  Status             Int
  CreatedAt          DateTime     @db.Timestamptz(6)
  RejectionReason    String?

  @@index([ServiceItemId], map: "IX_Appointments_ServiceItemId")
  @@map("appointments")
}

model B2BInquiry {
  Id               Int      @id @default(autoincrement())
  OrganizationName String
  ContactPerson    String
  Email            String
  Phone            String
  BusinessType     Int
  City             String?
  Message          String?
  Status           Int
  CreatedAt        DateTime @db.Timestamptz(6)

  @@map("b2binquiries")
}

model CallbackRequest {
  Id          Int      @id @default(autoincrement())
  Name        String?
  PhoneNo     String
  IsContacted Boolean
  CreatedAt   DateTime @db.Timestamptz(6)

  @@map("callbackrequests")
}

model ContactMessage {
  Id        Int      @id @default(autoincrement())
  Name      String
  Email     String?
  Phone     String?
  Message   String
  IsRead    Boolean
  CreatedAt DateTime @db.Timestamptz(6)

  @@map("contactmessages")
}

model ContentBlock {
  Id        Int      @id @default(autoincrement())
  PageSlug  String   @db.VarChar(255)
  Key       String   @db.VarChar(255)
  Title     String?
  Body      String?
  ImageUrl  String?
  SortOrder Int
  UpdatedAt DateTime @db.Timestamptz(6)

  @@unique([PageSlug, Key], map: "IX_ContentBlocks_PageSlug_Key")
  @@map("contentblocks")
}

model FeatureCard {
  Id        Int     @id @default(autoincrement())
  PageSlug  String
  IconKey   String
  Title     String
  Body      String?
  ImageUrl  String?
  SortOrder Int
  IsActive  Boolean

  @@map("featurecards")
}

model ServiceCategory {
  Id          Int           @id @default(autoincrement())
  Name        String
  Slug        String        @unique(map: "IX_ServiceCategories_Slug") @db.VarChar(255)
  Description String?
  ImageUrl    String?
  SortOrder   Int
  IsActive    Boolean
  Items       ServiceItem[]

  @@map("servicecategories")
}

model ServiceItem {
  Id                Int             @id @default(autoincrement())
  ServiceCategoryId Int
  ServiceCategory   ServiceCategory @relation(fields: [ServiceCategoryId], references: [Id], onDelete: Cascade)
  Name              String
  Description       String?
  Price             Decimal         @db.Decimal(10, 2)
  SortOrder         Int
  IsActive          Boolean
  DiscountPercent   Int?
  OfferBadgeText    String?
  Appointments      Appointment[]

  @@index([ServiceCategoryId], map: "IX_ServiceItems_ServiceCategoryId")
  @@map("serviceitems")
}

model SiteImage {
  Id        Int     @id @default(autoincrement())
  Section   String
  Url       String
  AltText   String?
  SortOrder Int
  IsActive  Boolean

  @@map("siteimages")
}

model Testimonial {
  Id             Int      @id @default(autoincrement())
  CustomerName   String
  RoleOrLocation String?
  Quote          String
  Rating         Int
  ImageUrl       String?
  SortOrder      Int
  IsActive       Boolean
  CreatedAt      DateTime @db.Timestamptz(6)

  @@map("testimonials")
}
